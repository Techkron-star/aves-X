<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch/Flutter first-frame background.
  Surface comes from `@color/launch_background` (light/dark in `values` + `values-night`),
  the mark is the same vector used by the adaptive icon (intrinsic 108dp, centered).
  Android 12+ uses `windowSplashScreenBackground` + `windowSplashScreenAnimatedIcon`
  from `styles.xml` instead; both are kept consistent.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/launch_background" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
