<?xml version="1.0" encoding="utf-8"?>
<!--
  Aves-X bat mark, adaptive icon foreground (Material 3 / Material You).
  Only flat shapes: no gradients, so the artwork stays crisp at every launcher size.
  The mark lives inside the 66/108 dp safe zone so launchers can apply any mask.
  Colors come from `@color/ic_launcher_*` so a themed/monochrome build only needs
  a resource override, never a new vector.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="24"
        android:translateY="24">
        <!-- lower left wing -->
        <path
            android:fillColor="@color/ic_launcher_logo_1"
            android:pathData="M31.784,63.612L48.252,80.08A2.911,2.911 0 0 1 48.252,84.196L40.379,92.069A15.067,15.067 0 0 1 19.072,92.069L11.2,84.197A2.911,2.911 0 0 1 11.2,80.08L27.668,63.612A2.911,2.911 0 0 1 31.785,63.612Z" />
        <!-- centre diamond -->
        <path
            android:fillColor="@color/ic_launcher_logo_2"
            android:pathData="M56.368,39.026L72.837,55.494A2.904,2.904 0 0 1 72.837,59.611L56.367,76.079A2.904,2.904 0 0 1 52.252,76.079L35.784,59.611A2.904,2.904 0 0 1 35.784,55.495L52.252,39.027A2.904,2.904 0 0 1 56.368,39.027Z" />
        <!-- right wing, with the inner counter as an even-odd hole -->
