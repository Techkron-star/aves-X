            android:fillType="evenOdd"
            android:pathData="M60.37,30.908A2.91,2.91 0 0 0 60.37,35.025L76.838,51.492A2.91,2.91 0 0 0 80.954,51.492L97.422,35.025A2.91,2.91 0 0 0 97.422,30.908L89.248,22.734A14.64,14.64 0 0 0 68.544,22.734ZM76.624,30.695A3.213,3.213 0 0 1 81.167,30.695A3.213,3.213 0 0 1 81.167,35.237A3.213,3.213 0 0 1 76.624,35.237A3.213,3.213 0 0 1 76.624,30.694Z" />
        <!-- upper left wing -->
        <path
            android:fillColor="@color/ic_launcher_logo_4"
            android:pathData="M24.305,6.96L48.35,31.004A2.911,2.911 0 0 1 48.35,35.121L31.882,51.588A2.911,2.911 0 0 1 27.765,51.588L17.084,40.907A22.738,22.738 0 0 1 17.084,8.75L18.874,6.96A3.84,3.84 0 0 1 24.305,6.96Z" />
    </group>
</vector>
