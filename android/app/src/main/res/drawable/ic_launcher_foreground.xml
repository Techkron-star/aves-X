<?xml version="1.0" encoding="utf-8"?>
<!--
  Aves-X Nosferatu bat mark, adaptive icon foreground (Material 3 / Material You).
  Single bat shape with wings, ruby crystal style.
  The mark lives inside the 66/108 dp safe zone so launchers can apply any mask.
  Colors come from `@color/ic_launcher_*` so a themed/monochrome build only needs
  a resource override, never a new vector.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.55"
        android:scaleY="0.55"
        android:translateX="24"
        android:translateY="24">
        <!-- Single bat shape: body, head, wings, keyhole -->
        <path
            android:fillColor="@color/ic_launcher_bat"
            android:pathData="M50,22L43,8L41,26C26,20 8,28 2,48Q10,50 15,47Q21,62 29,56Q33,72 42,64L50,92L58,64Q67,72 71,56Q79,62 85,47Q90,50 98,48C92,28 74,20 59,26L57,8Z" />
        <!-- Keyhole -->
        <path
            android:fillColor="@color/ic_launcher_keyhole"
            android:pathData="M50,50m-6,0a6,6 0 1,1 12,0a6,6 0 1,1 -12,0ZM50,54L53.5,54L55.5,70L44.5,70Z" />
    </group>
</vector>