<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Flutter first frame: surface + centered mark -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ splash uses the adaptive icon so launchers apply the same mask -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher</item>

        <!-- API28+, draws next to the notch in fullscreen -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>
</resources>
